# --- required in production ---
JWT_SECRET=change-me-to-64-random-hex-chars
DB_PATH=/data/rpc.sqlite
PORT=8787
# origins allowed to call the API (web app, Capacitor app)
CORS_ORIGINS=https://your-domain.example,capacitor://localhost,https://localhost,http://localhost
# the first account signing up with this email becomes the administrator
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# --- sign-in providers (optional; buttons switch on when set here AND in the app build) ---
GOOGLE_CLIENT_IDS=xxxxxxxx.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.Vibo.myvibo.signin
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Google Play purchases (cosmetics + VIP) ---
PLAY_PACKAGE_NAME=com.Vibo.myvibo
# service-account JSON (inline) or a path to the JSON file; needs "View financial data" + "Manage orders" in Play Console
PLAY_SERVICE_ACCOUNT_JSON=/secrets/play-service-account.json
# shared secret in the Pub/Sub push URL: https://your-domain/v1/purchases/rtdn?token=...
RTDN_TOKEN=change-me

# --- tuning ---
MIN_TOURNAMENT_FIELD=6
TOURNEY_LEVEL_MS=240000
LOG_REQUESTS=1
