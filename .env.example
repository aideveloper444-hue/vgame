# Royal Poker Club app build settings (copy to .env.production before `npm run build` / the APK build)
# where the game server lives (https in production)
VITE_RPC_SERVER=https://your-domain.example
# sign-in client ids (must match the server's GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS / FACEBOOK_APP_ID)
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
