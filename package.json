{
  "name": "vgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:poker": "rolldown src/games/poker/engine/engine.test.ts --platform node --format esm --file node_modules/.cache/poker-test.mjs --log-level warn && node node_modules/.cache/poker-test.mjs",
    "server:build": "rolldown server/src/main.ts --platform node --format esm --file server/dist/server.mjs --log-level warn",
    "server": "npm run server:build && node --env-file-if-exists=server/.env server/dist/server.mjs",
    "server:check": "tsc -p server/tsconfig.json",
    "test:wildbound": "rolldown src/games/wildbound/engine/engine.test.ts --platform node --format esm --file node_modules/.cache/wildbound-test.mjs --log-level warn && node node_modules/.cache/wildbound-test.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-social-login": "^8.7.6",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.2.6",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "framer-motion": "^13.4.3",
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "ws": "^8.22.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
